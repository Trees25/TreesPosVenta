{
  "suscripciones": {
    "required": [
      "id",
      "id_auth"
    ],
    "properties": {
      "id": {
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "bigint",
        "type": "integer"
      },
      "id_auth": {
        "format": "uuid",
        "type": "string"
      },
      "id_empresa": {
        "format": "bigint",
        "type": "integer"
      },
      "id_plan": {
        "description": "Note:\nThis is a Foreign Key to `planes.id`.<fk table='planes' column='id'/>",
        "format": "bigint",
        "type": "integer"
      },
      "fecha_inicio": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "fecha_fin": {
        "format": "timestamp with time zone",
        "type": "string"
      },
      "estado": {
        "default": "trial",
        "format": "text",
        "type": "string"
      },
      "preapproval_id": {
        "format": "text",
        "type": "string"
      },
      "payer_email": {
        "format": "text",
        "type": "string"
      }
    },
    "type": "object"
  },
  "planes": {
    "required": [
      "id",
      "nombre"
    ],
    "properties": {
      "id": {
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "bigint",
        "type": "integer"
      },
      "nombre": {
        "format": "text",
        "type": "string"
      },
      "monto": {
        "default": 0,
        "format": "numeric",
        "type": "number"
      },
      "frecuencia": {
        "format": "text",
        "type": "string"
      },
      "id_producto": {
        "default": 1,
        "format": "integer",
        "type": "integer"
      },
      "fecha_creacion": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      }
    },
    "type": "object"
  }
}